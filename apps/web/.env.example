# Server-only settings for the Space website. The browser never sees them, so never
# give them a VITE_ prefix. `npm run dev` and `npm start` also read them from .env.local.

# How the website guards this Space. "key" (the default) asks each browser once for
# SPACE_ACCESS_KEY. "private" checks nothing: use it only on localhost or behind a VPN.
# The API service must use the same mode.
SPACE_ACCESS_MODE=key

# The installation's access key, at least 32 characters, shared with the API service.
# The website sends it to the API itself; browsers only get a signed session cookie,
# and changing the key locks every browser. Generate one with: openssl rand -base64 48
SPACE_ACCESS_KEY=

# The exact public origin people open, such as https://space.example.com. Writes from
# any other origin are refused, and an https:// origin makes the session cookie Secure.
SPACE_WEB_URL=http://127.0.0.1:3000

# The API the website forwards /api calls to. An internal address works, such as
# http://api:8000 in Docker Compose. Unset, it is http://127.0.0.1:<BACKEND_PORT or 8000>.
# SPACE_API_URL=http://127.0.0.1:8000

# Optional display name of the owner (default: Owner).
# SPACE_OWNER_NAME=

# Where `npm start` listens. The default host only accepts connections from this machine;
# the Docker image listens on 0.0.0.0:3000.
# HOST=127.0.0.1
# PORT=3000
