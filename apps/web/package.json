{
  "name": "@space/web",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22.12 <27"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node scripts/serve.mjs",
    "typecheck": "node scripts/route-tree.mjs && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "postinstall": "node scripts/prepare-imports.mjs && node scripts/prepare-assets.mjs",
    "predev": "node scripts/prepare-imports.mjs && node --experimental-strip-types scripts/prepare-skills.mjs && node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-imports.mjs && node --experimental-strip-types scripts/prepare-skills.mjs && node scripts/prepare-assets.mjs",
    "test:e2e": "e2e run",
    "test:e2e:stack": "e2e run --config e2e.stack.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "2.1.3",
    "@tanstack/query-core": "5.104.0",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "d3-force": "^3.0.0",
    "effect": "4.0.0",
    "fflate": "^0.8.3",
    "idb": "8.0.3",
    "mammoth": "^1.12.3",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "read-excel-file": "^9.3.10",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.12.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "ai": "^7.0.0",
    "e2e": "^0.17.0",
    "fake-indexeddb": "6.2.4",
    "typescript": "^5.9.0",
    "vite": "8.3.2"
  },
  "type": "module"
}
