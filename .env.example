# The settings compose.yaml reads. scripts/setup.sh writes .env from scratch with fresh
# secrets; this file only documents the names. See docs/SELF_HOSTING.md#configuration.

# key: the website asks for SPACE_ACCESS_KEY once per browser, agents use tokens.
# private: no access check; keep the instance on localhost or a VPN.
SPACE_ACCESS_MODE=key
# At least 32 characters; setup generates 64 random hexadecimal characters.
SPACE_ACCESS_KEY=

# How people and agents reach Space, without a trailing slash.
SPACE_PUBLIC_URL=https://space.example.com
SPACE_ALLOWED_HOSTS=["space.example.com","localhost","127.0.0.1","api"]
# A domain name (automatic HTTPS) or ":80" (plain HTTP on a private network).
CADDY_SITE_ADDRESS=space.example.com
SPACE_BIND_ADDRESS=0.0.0.0
SPACE_HTTP_PORT=80
SPACE_HTTPS_PORT=443
SPACE_OWNER_NAME="Owner"

# Database passwords. The installer applies them on every start.
POSTGRES_PASSWORD=
SPACE_APP_DB_PASSWORD=
SPACE_WORKER_DB_PASSWORD=
SPACE_WEBHOOK_DB_PASSWORD=

# Optional model provider for automatic memory.
SPACE_MEMORY_PROVIDER=disabled
SPACE_MEMORY_PROVIDER_URL=
SPACE_MEMORY_API_KEY=
SPACE_MEMORY_TEXT_MODEL=
SPACE_MEMORY_EMBEDDING_MODEL=
SPACE_MEMORY_EMBEDDING_DIMENSIONS=1536
