# Local development settings for `make install`, `make backend` and the workers.
# Copy this file to backend/.env, which git ignores. A Docker installation uses the root
# .env written by scripts/setup.sh instead. See docs/DEVELOPMENT.md.
SPACE_ENVIRONMENT=development

# key: the website asks for SPACE_ACCESS_KEY; private: no access check, fine on your
# own machine. The website (apps/web/.env.local) must use the same mode and key.
SPACE_ACCESS_MODE=private
SPACE_ACCESS_KEY=
SPACE_WEB_URL=http://127.0.0.1:3000
# Defaults to http://127.0.0.1:<BACKEND_PORT>/mcp/.
# SPACE_MCP_RESOURCE_URL=http://127.0.0.1:8000/mcp/

# A local PostgreSQL with pgvector, for example:
#   docker run -d --name space-dev-db -p 127.0.0.1:5432:5432 \
#     -e POSTGRES_PASSWORD=change-me-postgres -e POSTGRES_DB=space \
#     pgvector/pgvector:0.8.2-pg17
# The migration URL is that container's superuser. The other three name the restricted
# logins and the passwords `make install` gives them. Percent-encode special characters.
SPACE_MIGRATION_DATABASE_URL=postgresql://postgres:change-me-postgres@127.0.0.1:5432/space
SPACE_DATABASE_URL=postgresql://space_app:change-me-app@127.0.0.1:5432/space
SPACE_JOB_DATABASE_URL=postgresql://space_worker:change-me-worker@127.0.0.1:5432/space
SPACE_WEBHOOK_DATABASE_URL=postgresql://space_webhook:change-me-webhook@127.0.0.1:5432/space
SPACE_DATABASE_SSLMODE=disable

# Optional model provider for automatic memory. See docs/SELF_HOSTING.md#configuration.
SPACE_MEMORY_PROVIDER=disabled
SPACE_MEMORY_PROVIDER_URL=
SPACE_MEMORY_API_KEY=
SPACE_MEMORY_TEXT_MODEL=
SPACE_MEMORY_EMBEDDING_MODEL=
# Set before `make install` when the embedding model does not produce 1,536 dimensions.
SPACE_MEMORY_EMBEDDING_DIMENSIONS=1536
